generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"

}

enum Role {
  ADMIN
  OWNER
  CLIENT
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String?  @unique
  phone              String   @unique
  passwordHash       String
  role               Role     @default(OWNER)
  mustChangePassword Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Infos professionnelles
  raisonSociale      String?
  adresse            String?
  ville              String?
  pays               String?  @default("Cameroun")
  numeroRCCM         String?
  numeroContribuable String?
  numeroTVA          String?
  cgv                String?  // Conditions générales de vente

  clients      Client[]
  invoices     Invoice[]
  quotes       Quote[]
  devis         Devis[]
bonsCommande  BonCommande[]
bordereaux    Bordereau[]
  resetLogs    PasswordResetLog[] @relation("ResetTarget")
  resetsDone   PasswordResetLog[] @relation("ResetBy")
}

model PasswordResetLog {
  id        String   @id @default(cuid())
  userId    String
  resetById String
  resetAt   DateTime @default(now())

  user      User @relation("ResetTarget", fields: [userId], references: [id])
  resetBy   User @relation("ResetBy", fields: [resetById], references: [id])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  ifu String?
  createdAt DateTime @default(now())

  ownerId  String
  owner    User      @relation(fields: [ownerId], references: [id])
  invoices Invoice[]
  quotes   Quote[]
  devis         Devis[]
bonsCommande  BonCommande[]
bordereaux    Bordereau[]
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  status      InvoiceStatus @default(UNPAID)
  totalAmount Float
  dueDate     DateTime?
  pdfUrl      String?
  createdAt   DateTime      @default(now())

  ownerId  String
  owner    User          @relation(fields: [ownerId], references: [id])
  clientId String
  client   Client        @relation(fields: [clientId], references: [id])
  items    InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  total       Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model Quote {
  id          String      @id @default(cuid())
  number      String      @unique
  status      QuoteStatus @default(PENDING)
  totalAmount Float
  pdfUrl      String?
  createdAt   DateTime    @default(now())

  ownerId  String
  owner    User        @relation(fields: [ownerId], references: [id])
  clientId String
  client   Client      @relation(fields: [clientId], references: [id])
  items    QuoteItem[]
}

model QuoteItem {
  id          String @id @default(cuid())
  description String
  quantity    Float
  unitPrice   Float
  total       Float

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])
}
model Devis {
  id          String      @id @default(cuid())
  number      String      @unique
  status      QuoteStatus @default(PENDING)
  totalAmount Float
  dueDate     DateTime?
  dateValidite        String?
  remise              Float?      @default(0)
  conditionsReglement String?
  delaisLivraison     String?
  createdAt   DateTime    @default(now())

  ownerId  String
  owner    User   @relation(fields: [ownerId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])
}

model BonCommande {
  id          String   @id @default(cuid())
  number      String   @unique
  totalAmount Float
  dateLivraison       String?          
  adresseLivraison    String?          
  remise              Float?           @default(0)
  conditionsReglement String?          
  modePaiement        String?          
  createdAt   DateTime @default(now())

  ownerId  String
  owner    User   @relation(fields: [ownerId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])
}

model Bordereau {
  id          String   @id @default(cuid())
  number      String   @unique
  dateLivraison       DateTime // Date effective ou prévue de livraison
  adresseLivraison    String   // Lieu exact de déchargement
  livreur             String?  // Nom du chauffeur / livreur
  modeTransport       String   // Ex: "Routier", "Maritime", "Propre compte"
  immatriculation     String?  // Plaque du véhicule de transport
  nombreColis         Int      @default(1) // Nombre total de colis
  
  // Consignes et indicateur financier logistique
  conditionsLivraison String?  @db.Text // Instructions ou réserves particulières
  payeALaLivraison    Boolean  @default(false) // Condition d'encaissement (Contre-remboursement)
  createdAt   DateTime @default(now())
  updatedAt           DateTime @updatedAt
  ownerId  String
  owner    User   @relation(fields: [ownerId], references: [id])
  clientId String
  client   Client @relation(fields: [clientId], references: [id])
}